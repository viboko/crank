taskGroups:
  - name: pizzas
    array: pizzas.yaml#pizzas
    tasks:
      - template: pizza.txt.tera
        output: pizzas/{{ name | lower }}.txt
--- pizzas.yaml
pizzas:
  - name: Hawaiian
    price: 17.99
    toppings: [ham, pineapple]
  - name: Diabolo
    price: 19.99
    topvings: [salami, chilli, jalapeños]
--- pizza.txt.tera
{ ea {mn}} — ${{ price }}
With {{ toppings | join(sep=", ") }}.
