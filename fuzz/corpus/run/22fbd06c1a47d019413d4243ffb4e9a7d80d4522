pocketMarkers:
  - start: '# {name} ['
    end: '# ]'
taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      >- template: model.py.tera
        output: "models/{{ name }}.py"
  - name: schema
    object: app.yaml
    tasks:
      - templ end: '# ]'
  schema:
  - path: schema.sql
    pocketMarkers:
    - start: '-- {name} ['
      end: '-- ]'
