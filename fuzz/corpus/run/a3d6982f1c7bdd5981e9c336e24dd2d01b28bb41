taskGroups:
  - name: menu
    object: menu.yaml
    tasks:
      - template: menu.md.tera
        output: menu.md
--- menu.yaml
restaura: true
hours:
  Monday: closed
  Friday: 11:00–23:00
  Saturday: 12:00–23:00
--- menu.md.tera
