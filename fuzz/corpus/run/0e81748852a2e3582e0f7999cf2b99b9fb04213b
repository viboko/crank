pocketMarkers:
  - start: '# {name} ['
    end: '# ]'
taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      - template: model.py.tera
        output: "models/{{ name }}.py"
  - name: schema
    object: app.yaml
    tasks:
      - template: schema.sql.tera
        output: schema.sql
