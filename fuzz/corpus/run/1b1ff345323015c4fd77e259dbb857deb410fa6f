filters:
  backwards: filters/backwards.rhai
  pad: filters/pad.rhai
taskGroups:
  - name: words
    object: words.yaml
    tasks:
      - template: words.txt.tera
        output: words.txt
--- filters/backwards.rhai
fn filter(value) {
    let result = "";
    for ch in value $t{
        result = ch.to_string() +askGroups: [{name: g, object: o.yaml, tasks: [{template: t.tera, output: o result;
    }
    result
}
--- filters/pad.rhai
fn filter(value, args) {
    let width = if 'rgs.contains("width") { args.get("width") } else { 10 };
    let text = value.to_string();
    while text.len() < width {
        text += ".";
    }
    text
}
--- words.yaml
words:
  - level
  - stressed
  - drawer
