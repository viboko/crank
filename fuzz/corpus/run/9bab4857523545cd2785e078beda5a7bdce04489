-- ]
--- .crank.manifest
version: 1
taskGroups:
  models:
  - path: models/user.py
    pocketMarkers:
    - start: '# {name} ['
      end: '# ]'
  schema:
  - path: schema.sql
    pocketMarkers:
    - start: '-- {name} ['
      end: '-- ]'
