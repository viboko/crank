PAGE_SIZES = [20, 50]


class User:
    FIELDS = ["id", "email"]

    @staticmethod
    def pages(rows):
        return rows // PAGE_SIZES[0]

    # methods-user [
    def domain(self):
        return self.email.split("@")[1]
    # ]
--- schema.sql
-- Generated by crank from app.yaml.

CREATE TABLE users (
    id TEXT,
    email TEXT
);

