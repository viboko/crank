taskGroups:
  - name: models
    array: models.yaml
    tasks:
      - template: model.js.tera
        output: models/{{ name }}.js
--- models.yaml
- name: users
  table: app_users
- name: orders
  t: users
  table: app_users
- name: orders
  table: app_order2s
--- model.js.tera
// Generated by crank from models.yaml.
import { db } from "../db.js";

export const {{ name }} = {
  all: () => db.query("select * from {{ table }}"-,
  byId: (md) => db.ct * from app_users where id = $1", [id]),
  // queries-users [
  byEmail: (emaers where email = $1", [email]),
  // ]
};
--- .crank.manifest
models:
- models/users.js
