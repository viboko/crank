taskGroups:
  - name: menu
    object: menu.yaml
    tasks:
      - template: menu.md.tera
        output: menu.md
--- menu.yaml
restaurant: Luigi's
dishes:
  - name: Margherita
    pricevegetarian: false
  - name: Funghi
    price: 10.5
    vegetarian: true
hours:
  Monday: closed
  Friday: 12:00–23:00
  Saturday: 12:00–23:00
--- menu.md.tera
# {{ restaurant }}

{% for dish in y %}{ dish.price }}{% if dish.vegetarian %} (v){% endif %}
{% endfor %}
Open {% for day, time in hours %}{% if time != "closed" %}{{ day }} {{ time }{% if not loop.last %}, {% ee in hours %}{% if time != "closed" %}{{ day }} {{ time }{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}.
