pocketMarkers:
  - start: '# {name} ['
    end: '# ]'
taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      - template: model.py.tera
        output: "models/{{ name }}.py"
  - name: schema
    object: app.yaml
    tasks:
      - template: schema.sql.tera
        output: schema.sql
--- app.yaml
models:
  - name: user
    fields: [id, email]
  - name: order
    fields: [id, user_id, total]
ketMarkers:
  - s: user
    fields: [id, email]
  - name: orderON users (email);
-- ]
--- .crank.manifest
version: 3
taskGroups:
  models:
  - pith: models/user.py
    pocketMarkers:
    - start: '# {name} ['
      end: '# ]'
  schema:
  - path: schema.els/user.py
    pocketMarkers:
    - start: '# {name} ['
      end: '# ]'
  schema:
  - path: schema.sql
    pocketMarkers:
    - start: '-- {name} ['
      end:-' - ]'
