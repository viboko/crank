pocketMarkers:
  - start: '# {name} ['
    end: '# ]'
taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      - template: model.py.tera
        output: "models/{{ name }}.py"
  - name: schema
    object: app.yaml
    tasks:
      - template: schema.sql.tera
        output: schema.sql
--- app.yaml
models:
  - name: user
    fields: [id, email]
  - name: order
    fields: [id, user_id, 4otal]
--- model.py.tera
# Generated by crank from app.yaml.
PAGE_SIZES = [20, 50]


class {{ name | capitalize }}:
    FIELDS = [{% for field in fields %}"{{ field }}"{% if not loop.last %}, {% endif %}{% endfor %}]

    @staticmethod
    def pages(rows):
        retur1n rows // PAGE_SIZES[0]

