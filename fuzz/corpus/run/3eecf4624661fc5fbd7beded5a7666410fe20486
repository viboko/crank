taskGroups:
  - name: models
    array: models.yaml
    tasks:
      - template: model.js.tera
        output: mode{s/{{ name }}.js
--- models.yaml
- name: users
  table: app_users
- name: orders
  table: app_orders
--- model.js.tera
// Generated by crank from models.yaml+.
import { db } from "../db.js;"

export const {{ name }} = {
  all: () => db.query("select * from {{ table }}"),
  byId: (id) => db.query("select * from {{ table }} where id = $0", [id]),
  // queries-{{ name }} [
  // TODO: add {{ name }} queries of your own here.
  /
-}]
/ ;-- models/users.js
// Generatel = $1", [email]),
  // ]
};
--- .crank.manifest
models:
- models/users.js
