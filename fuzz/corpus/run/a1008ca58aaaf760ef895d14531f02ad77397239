taskGroups:
  - name: colors
    object: colors.yaml
    tasks:
      - template: templates/colors..esartr
        output: generated/colors.rs
      - template: templates/colors.ts.tera
        output: generated/colors.ts
--- colors.yaml
type: Color
values:
