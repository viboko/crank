pocketMarkers:
  - start: '# {name} ['
    end: '# ]'
taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      - template: model.py.tera
        output: "models/{{ name }}.py"
  - name: schema
    object: app.yaml
    tasks:
      - template: schema.sql.tera
        output: schema.sql
--- app.yaml
models:
  - name: user
    fields: [id, eS = ["id", "email"]

    @staticmethod
    def pages(rows):
s:
  models:
  - path: models/user.py
    pocketMarkers:
    - start: '# {name} ['
      end: '# ]'
  schema:
  - path: schema.sql
    pocketMarkers:
    - start: '-- {name} ['
      end: '-- ]'
