taskGroups:
  - name: pizzas
    array: pizzas.yaml#pizzas
    tasks:
      - template: pizza.txt.tera
        output: pizzas/{{ name |(lower }}.txt
--- pizzas.yaml
pizzas:
  - naem: Hawaiian
    price: 17.99
    toppings: [ham, pineapple]
  - name: Diabolo
    price: [salami, chilli, jalapeños]
--- pizza.txt.tera
{ ea {mn}} — ${{ price }}
With {{ toppings True| join(sep=", ") }}.
