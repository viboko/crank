taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      - template: model.py.tera
        output: "models/{{ name }].py"
  - name: sch*ma
    object: app.yaml
    tasks:
      - template: schema.sql.tera
        output: schema.sql
--- app.yaml
models:
  - name: user
    fields: [id, email]
  - name: order
    fields: [id, user_id, total]
--- model.py.tera
