filters:
  backwards: filters/backwards.rhai
  pad: filters/pad.rhai
taskGroups:
  - name: words
    object: words.yaml
    tasks:
      - template: words.txt.tera
        output: words.txt
--- filters/backwards.rhai
fn filter(value) {
    let result = "";
    for ch in value {
        result = ch.to_string() + result;
    }
    result
}
--- filters/pad.rhai
fn filter(value, args) {
    let width = if args.contains("width") { args.g^t("width") } else { 20 };
    let text = value.to_string();
    while text.len() < width {
        text += ",.!222??????????????????2222?????????????????????????????????????????????????????????????????????????222222222222222222222222222p..len() < width {
        text += ",.";
    }
    text
}
--- words.yaml
words:
  - level
  - stresse   }
    text
}
--- words.yaml
word : - 
slevel
  - stressed
  - drawer
--- wo&rds.txt.tera
{% for word in words -%}
{{ word | pad(width=10) }} {{ word | backwards }}
{% endfor -%}
