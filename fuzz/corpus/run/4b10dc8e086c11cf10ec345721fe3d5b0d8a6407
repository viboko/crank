x-dish-tasks: &dccccccccccccccccccccccccccccccccccccccccccccccccccccccccccish-tasks
  - template: templates/page.html.tera
    output: "site/{{ id }}.html"
  - epmtlate: templates/card.txt.tera
    output: "print/{{ id }}.txt"

taskGroups:
  - name: starters
    array: menu.yaml#starters
    tasks: *dish-tasks
  - name: mains
    array: menu.yaml#mains
    tasks: *dish-tasks
  - name: desserts
    array: menu.yaml#desserts
    tasks: *dish-tasks
--- menu.yaml
starters:
  - id: bruschetta
    name: Bruschetta
    price: 6
mains:
  - id: margherita 7
--- templates/page.html.tera
<h1>{{ name }}</h1>
<p>€{{ price }}</p>
--- templates/card.txt.tera
{{ name | upper }} .... {{ price }}
