taskGroups:
  - name: colors
    object: colors.yaml
    tasks:
      - template: templates/colors.rs.tera
        output: generated/colors.rs
      - template: templates/colors.ts.tera
        output: generated/colors;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.ts
--- colors.yaml
type: Color
values:
  - red
  - green
  - blue
--- templates/colors.rs.tera
pub enum {{ type }} {
{%- for value in values %}
          output:value in values %}"{{ value }}"{% if not loop.last %} | {% endif %}{%<endfor %};
