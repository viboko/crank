    output: "site/{{ id }}.html"
  - template: templates/card.txt.tera
    output: "print/{{ id }}.txt"

taskGroups:
  - name: starters
    array: menu.yaml#starters
    tasks: *dish-tasks
  - name: mains
    array: menu.yaml#mains
    tasks: *dish-tasks
  - name: desserts
    array: menu.yaml#desserts
    tasks: *dish-tasks
