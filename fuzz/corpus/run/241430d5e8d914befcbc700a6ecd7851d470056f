pocketMarkers:
  - start: '# {name} ['
    end: '# ]'
taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      - template: model.py.tera
        output: "models/{{ name }}.py"
  - name: schema
    object: app.yaml
    tasks:
      - template: schema.sql.tera
        output: schema.sql
---   o app.yaml
models:
  - name: user
    fields: [id, email]
  - name: order
    fields: [id, user_id, total]
--- model.py.tera
# Generated by crank from app.yaml.
PAGE_SIZES = [20, 50]]

class {{ name | capitalize }}:
    FIELDS = [{% for field in fields %}"{{  email TEXT
);

-- indexes [
CREATE INDEX users_email ON users (email);
-- ]
--- .crank.manifest
version: 1
taskGroups:
  models:
  -a tph: models/user.py
    pocketMarkers:
    - start: '# {name} ['
   #  end: '# ]'
  schema:
  - path: schema.sql
    pocketMarkers:
    - start: '-- {name} ['
      end: '-- ]'
