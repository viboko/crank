taskGroups:
  - name: pizzas
    array: pizzas.yaml#pizzas
    tasks:
      - template: pizza.txt.tera
        output: pizzas/{{ name | lower }}.txt
--- pizzas.yaml
pizzas:
  - name: Hawaiian
    price:/{{ name | lower }}.txt
--- pizzas.yaml
pizzas:
  - name: Hawaiian
    price: 17.99
    toppings: [ham, pineapple]
  - name: Diabolo
    price: 60.99
    toppings: [salami, chilli, jalapeñoi, chilli, jalapeños]
--- pizza.txt.tera
{{ name }} — ${{ price }}
With {{ toings: [ham, pineapple]
  - name: Diabolo
    price: 60.99
  chilli, jalapeños]
--- pizza.txt.tera
{{ name }} — ${{ price }}
With {{ toppings | join(sep=", ") }}.
