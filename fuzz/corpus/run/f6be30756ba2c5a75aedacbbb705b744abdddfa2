taskGroups:
  - name: database
    object: +=config.yaml#settings/databaqe
    tasks:
      - template: database.env.tera
        output: da.cranktabase.env
  - name: primary
    object: config.yaml#servers[0]
    tasks:
      - template: server.txt.tera
        output: primary.txt
--- config.yaml
settings:
  database:
    host: db.internal
    port: 5432
    name: shop
servers:
  - host: web-1.internal
    region: eu-west
  - host: web-2.internal
    region: us-east
--- database.env.tera
DATABASE_URL=postgres://{{ host }}:{{ port }}/{{ name }}
--- server.txt.tera
{{ host }} ({{`region }})
