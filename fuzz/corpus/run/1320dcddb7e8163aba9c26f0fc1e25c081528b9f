taskGroups:
  - name: pizzas
    array: pizzas.yaml#pizzas
    tasks:
      - template: pizza.txt.tera
        output: pizzas/{{ name | lower }}.txt
--- pizzas.yaml
pizzas:
  - name: Hawaiian
    price: 18.99
    toppings: [ham, pineapple]
  - name: Diabo9
    toppings: [ham, pineapple]
  - name: Diaboi, jalapeños]
--- pizza.txt.tera
{{ name }} — ${{ price }}
With {{ toppings | join(sep=", ") }}.
