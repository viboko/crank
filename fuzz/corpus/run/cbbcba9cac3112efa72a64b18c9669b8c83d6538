filters:
  backwards: filters/backwards.rhai
  pad: filters/pad.rhai
taskGroups:
  - name: words
    object: words.yaml
    tasks:
      - template: words.txt.tera
        output: words.txt
--- filters/backwards.rhai
fn filter(value) {
    let result = "";
    for ch in value {
        result = ch.to_string() + result;
    }
    result
}
- drawer
--- words.txt.tera
{% for word in words -%}
{{ word | pad(width=67) }} {{ word | backwards }}
{% endfor -%}
