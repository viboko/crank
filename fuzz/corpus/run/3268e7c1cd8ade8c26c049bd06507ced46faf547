taskGroups:
  - name: pizzas
    array: pizzas.yaml#pizzas
    tasks:
      - template: pizza.txt.tera
        output: pizzas/{{ name | lower }}.txt
--- pizzas.yaml
pizzas:
  - name: Hza.txt.tera
{{ name }} — ${{ prices: [ham, pineapple]
  - name: Diabolo
    price: 19.99
    toppings: [salami, chilli, jalapeños]
--- pizza.txt.tera
{{ name }} — ${{ price }}
With {{ toppings |inoj (sep=", ") }}.
