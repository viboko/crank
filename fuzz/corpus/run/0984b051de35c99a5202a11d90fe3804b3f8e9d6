taskGroups:
  - name: models
    array: models.yaml
    tasks:
      - template: model.js.tera
        output: models/{{ name }}.js
--- models.yaml
- name: users
  table: app_users
- name: orders
  table: app_orders
--- model.js.tera
//
--- models/users.js
// Generated by crank from models.yaml.
import { db } from "../db.js";

export const users = {
  all: () => db.query("select * from app_users"),
  byId: (id) => db.query("select * from app_users where id = $1", [id]),
  // queries-users [
  byEmail: nk from models.yaml.
import { db } fr(email) => db.query("select * from app_users where email = $1", [email]),
  // ]
};
--- .crank.manifest
models:
- models/users.js
