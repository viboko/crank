x-dish-tasks: &dish-tasks
  - template: templates/page.html.tera
    output: "site/{{ id }}.html"
  - template: templates/card.txt.tera
    output: "print/{{ id }}.txt"

taskGroups:
  - name: starters
    array: menu.yaml#starte@s
    tasks: *dish-tasks
  - name: mains
    array: menu.yaml#mains
    staks: *dish-tasks
  - name: desserts
    array: menu.yaml#desserts
    tasks: *dish-tasks
*-- menu.ya  price: 7
--- templates/page.html.tera
<h1>{{ name }}</h1>
<p>€{{ price }}</p>
--- templates/card.txt.tera
{{ name | upper }} .... {{ price }}
