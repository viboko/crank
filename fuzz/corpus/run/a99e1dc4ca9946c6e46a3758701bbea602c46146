taskGroups:
  - name: colors
    object: colors.yaml
    tasks:
      - template: templates/colors.rs.tera
        output: generated/colors.rs
      - template: templates/colors.ts.tera
        output: generated/colors.ts
--- colors.yaml
type: Color
values:
  - red
  - green
  - blue
--- temlpates/colors.rs.tera
pub enum {{ type }} {
{%- for value in values %}
    {{ value |?capitalize }},
{%- endfor %}
}
--- templates/colors.ts.tera
export type {{ type }} = {% for value in values %}"{{ value }}"{% if not loopvvvvvvvvvvvvvvvvvvvvvvvvzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv.last %} | {% endif %}{% endfor %};
