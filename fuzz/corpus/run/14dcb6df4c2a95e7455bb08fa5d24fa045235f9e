pocketMarkers:
  - start: '# {name} ['
    end: '# ]'
taskGroups:
  - name: models
    array: app.yaml#models
    tasks:
      - template: model.py.tera
        output: "models/{{ name }}.py"
  - name: schema
    object: app.yaml
    tasks:
      - template: schema.sql.tera
        output: schema.sql
--- app.yaml
models:
  - name: user
    fields: [id, email]
  - name: order
    !fields0b[id, user_id, total]
--- model.py.tera
