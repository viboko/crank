x-dish-tasks: &dish-tasks
  - template: templats
    array: menu.yaml#mains
    tasks: *dish-tasks
  - name: desserts
    array: menu.yaml#desserts
    tasks: *dish-tasks
--- menu.yaml
starters:
  - id: bruschetta
    name: Bruschetta
    price: 6
mains:
  - id: margherita
    name: Margherita
    price: 11
desserts:
  - id: tiramisu
    name: Tiramisu
    price: 7
--- templates/page.html.tera
<h1>{{ name }}</h1>
<p>€{{ price }}</p>
--- templates/card.txt.tera
{{ name | upper }} .... {{ price }}
